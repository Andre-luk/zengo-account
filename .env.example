# ---------------------------------------------------------------------------
# Zengo Account API - variables d'environnement
# Copier vers .env et adapter.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Zengo Account"
APP_URL=http://localhost:3000

# --- Base de donnees (PostgreSQL) ------------------------------------------
# En local sans Docker : lancer `npm run db:pg:start` (PostgreSQL embarque)
# et utiliser les valeurs ci-dessous (port 55432 par defaut).
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=zengo
DB_PASSWORD=zengo
DB_NAME=zengo_account
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Auth / JWT -------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=2592000
BCRYPT_SALT_ROUNDS=10

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- MQTT (kit SafAlert) -----------------------------------------------------
# Voir docs/MQTT-SAFALERT.md pour le protocole complet.
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sg

# --- Alertes & Zengo Monitoring Center --------------------------------------
# Temporisation du cahier des charges : 5 minutes sans action -> escalade a
# toutes les equipes actives du point de distribution.
ALERT_ESCALATION_SECONDS=300
ALERT_WATCHDOG_INTERVAL_SECONDS=30
ALERT_GROUPING_WINDOW_SECONDS=120
ALERT_AUTO_VOICE_CALL=true

# --- Telephonie / appel vocal IA --------------------------------------------
# STUB  : aucun appel reel, pilotable via /voice-calls/webhooks/stub/... (dev)
# TWILIO: appels reels (necessite les 3 variables ci-dessous)
TELEPHONY_PROVIDER=STUB
TELEPHONY_PUBLIC_BASE_URL=http://localhost:3000/api/v1
VOICE_CALL_TIMEOUT_SECONDS=45
VOICE_CALL_MAX_ATTEMPTS=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Canal SMS transactionnel ------------------------------------------------
# Le client est notifie par SMS en parallele de l'appel vocal IA.
# STUB  : aucun envoi reel, les messages sont tracés et lisibles dans la console
# TWILIO: envoi reel (TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN ci-dessus)
SMS_ENABLED=true
SMS_PROVIDER=STUB
SMS_NOTIFY_ON_ALERT=true
SMS_NOTIFY_ON_MISSION=true
SMS_NOTIFY_ON_CLOSURE=true
SMS_EMERGENCY_PHONE=+243 970 255 599
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SMS_STATUS_CALLBACK_URL=

# --- Interventions terrain ---------------------------------------------------
INTERVENTION_WATCHDOG_INTERVAL_SECONDS=60
INTERVENTION_DEPARTURE_WARN_MINUTES=5
INTERVENTION_ARRIVAL_WARN_MINUTES=45
INTERVENTION_POSITION_MAX_AGE_MINUTES=60
INTERVENTION_AVERAGE_SPEED_KMH=28

# --- Abonnements & encaissements ---------------------------------------------
# Taux applique lorsqu'un groupe tarifaire ne porte pas le sien, et mensualite
# de repli pour un client sans groupe tarifaire.
BILLING_EXCHANGE_RATE_USD_CDF=2800
BILLING_DEFAULT_MONTHLY_FEE_USD=20
# Restreint automatiquement l'acces des abonnements echus (watchdog 10 min).
BILLING_AUTO_EXPIRE=true
# Relance quotidienne par SMS des clients a moins de 7 jours de l'echeance.
BILLING_REMINDERS=true
# Secret partage des webhooks Mobile Money : si defini, l'en-tete
# x-operator-signature doit porter le HMAC-SHA256 attendu.
MOBILE_MONEY_WEBHOOK_SECRET=

# --- Supervision des dispositifs -------------------------------------------
DEVICE_OFFLINE_AFTER_SECONDS=300
DEVICE_PRESENCE_INTERVAL_SECONDS=60
